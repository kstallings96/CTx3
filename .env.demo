# The shareable demo must never carry the study database's credentials.
#
# Vite loads .env.[mode] at HIGHER priority than .env.local, so `vite build
# --mode demo` blanks these whatever a developer has set locally. The demo
# then runs exactly as it did before any backend existed: every network call
# is a no-op and events stay in localStorage.
#
# This file is committed on purpose. bundle-demo.mjs also refuses to write a
# demo containing a supabase.co URL, because a comment is not a guarantee.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
