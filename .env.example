# Copy to .env.local for local development, and set the same two values as
# Environment Variables in the Vercel project.
#
# Both are PUBLIC by design: Vite inlines any VITE_-prefixed value into the
# client bundle, and the anon key is meant to be visible. Row-level security
# (supabase/schema.sql) is what protects the data.
#
# NEVER put the service_role key here or anywhere in this app. It bypasses RLS
# entirely. Use it only from your own machine when pulling data for analysis.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — NO VITE_ PREFIX. Set this one in the Vercel dashboard,
# never in a committed file. Anything VITE_-prefixed ends up in the bundle.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
